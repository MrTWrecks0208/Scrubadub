# GEMINI_API_KEY: Required for AI Regex generation.
# On Netlify, set this variable in: Site Settings -> Environment Variables.
# Kept securely on the server/function side, away from front-end client bundles.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public URL of your deployed application (optional).
APP_URL="https://your-app-name.netlify.app"

# Optional: Firebase Client Configuration overrides (if connecting a custom Firebase project in Netlify)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

