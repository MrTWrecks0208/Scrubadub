# =====================================================================
# Scrubadub - Production Environment Variables Configuration
# =====================================================================

# Server Port (optional, defaults to 3000 if omitted)
# Most cloud providers (Docker, Cloud Run, Render, Railway, VPS) supply PORT automatically.
PORT=3000

# GEMINI_API_KEY: Required for AI Rule / Regex Generator.
# Kept securely on the backend server / serverless function.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The custom domain or public URL of your deployed application (optional).
APP_URL="https://yourcustomdomain.com"

# ---------------------------------------------------------------------
# Firebase Authentication & Firestore Configuration (Optional Overrides)
# If left empty, Scrubadub uses the default configured project credentials.
# Note for Custom Domains:
#   When hosting on a custom domain (e.g. https://yourdomain.com), remember
#   to add your domain in Firebase Console -> Authentication -> Settings -> Authorized Domains.
# ---------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""


